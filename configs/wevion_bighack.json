{
  "name": "wevion_bighack_2026",
  "root": "data/raw",
  "history": {"file": "storico_giornaliero.csv", "columns": {
    "date": "data", "ad_id": "ad_id", "audience_id": "adset_id", "creative_id": "asset_id",
    "advertiser_id": "campaign_id", "impressions": "impression", "clicks": "click",
    "spend": "spesa", "reach": "copertura", "budget": "budget_giornaliero_adset"}},
  "future": {"file": "da_prevedere.csv", "columns": {
    "date": "data", "ad_id": "ad_id", "audience_id": "adset_id", "creative_id": "asset_id",
    "advertiser_id": "campaign_id", "budget": "budget_giornaliero_adset"}},
  "ads": {"file": "annunci.csv", "columns": {"ad_id": "ad_id", "launch_date": "data_lancio"}},
  "audiences": {"file": "adset.csv", "columns": {"audience_id": "adset_id", "base_budget": "budget_giornaliero_iniziale"}},
  "creatives": {"glob": "asset_creativi/*.csv", "columns": {"creative_id": "asset_id"},
    "text": ["headline", "testo_principale", "call_to_action", "descrizione_visual"],
    "categorical": ["leva", "formato", "call_to_action"],
    "numeric": ["durata_video_s"]},
  "season": {"file": "benchmark_mercato_settimanale_2025.csv", "week_start": "settimana_dal",
    "group": {"history_column": "vertical", "season_column": "vertical"}, "lag_days": 364,
    "kpis": {"ctr": "indice_ctr", "cpm": "indice_cpm"},
    "smoothing": {"ctr": "none", "cpm": "pooled_unimodal"}},
  "priors": {"budget_elasticity": {"ctr": -0.1, "cpm": 0.3}, "prior_weight": 1.0},
  "blend": {"ctr": ["hier"], "cpm": ["hier", "tree", "level"]},
  "encoder": "auto",
  "archetypes": 4
}
